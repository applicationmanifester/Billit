rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Basic Ownership check
      function isOwner(uid) {
        return request.auth != null && request.auth.uid == uid;
      }
      
      // Check if usage is within plan limits
      function isWithinPlanLimits(data) {
        let plan = data.get('plan', 'free');
        let usage = data.get('invoicesGenerated', 0);
        return (plan == 'ultra') || 
               (plan == 'pro' && usage <= 500) || 
               (plan == 'free' && usage <= 100);
      }

      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) 
                    && request.resource.data.get('plan', 'free') == 'free'
                    && request.resource.data.get('invoicesGenerated', 0) == 0;

      allow update: if isOwner(userId)
                    // 1. Critical Safeguard: Prevent users from changing their own plan level
                    && (
                      request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free') || 
                      (!('plan' in resource.data) && request.resource.data.get('plan', 'free') == 'free')
                    )
                    // 2. Enforcement: Ensure invoice counts don't spoof above tier limits
                    && isWithinPlanLimits(request.resource.data);
                    
      // Only system handles deletions or other special cases if needed later
      allow delete: if false; 
    }
  }
}
